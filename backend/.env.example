# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/aptura

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Gmail SMTP (OTP emails)
# GMAIL_USER is the app's sender account only — NOT a user login.
# To get an app password: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Uploads
MAX_RESUME_SIZE_MB=10
